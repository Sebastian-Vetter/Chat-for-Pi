{
  "name": "pi-chat",
  "version": "1.0.7",
  "private": true,
  "description": "Local web workspace and background server for Pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sebastian-Vetter/Chat-for-Pi.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "chat"
  ],
  "pi": {
    "extensions": [
      "./extensions/distribution.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --no-error-on-unmatched-pattern \"{src,server,scripts,extensions,tests}/**/*.{ts,tsx,css}\" \"*.{json,ts,html}\" \".github/**/*.yml\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"{src,server,scripts,extensions,tests}/**/*.{ts,tsx,css}\" \"*.{json,ts,html}\" \".github/**/*.yml\"",
    "check": "npm run format:check && npm run typecheck",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts scripts/*.test.ts extensions/*.test.ts",
    "test:e2e": "playwright test",
    "pi:install": "tsx scripts/chat-server.ts install",
    "pi:uninstall": "tsx scripts/chat-server.ts uninstall",
    "server:start": "tsx scripts/chat-server.ts start",
    "server:status": "tsx scripts/chat-server.ts status",
    "server:stop": "tsx scripts/chat-server.ts stop",
    "server:restart": "tsx scripts/chat-server.ts restart",
    "server:logs": "tsx scripts/chat-server.ts logs",
    "server:open": "tsx scripts/chat-server.ts open",
    "release": "tsx scripts/release.ts",
    "package:build": "npm run build && tsx scripts/package.ts",
    "package:verify": "tsx scripts/verify-package.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
