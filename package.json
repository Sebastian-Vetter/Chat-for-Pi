{
  "name": "pi-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts scripts/*.test.ts extensions/*.test.ts",
    "test:e2e": "playwright test",
    "pi:install": "tsx scripts/chat-server.ts install",
    "pi:uninstall": "tsx scripts/chat-server.ts uninstall",
    "server:start": "tsx scripts/chat-server.ts start",
    "server:status": "tsx scripts/chat-server.ts status",
    "server:stop": "tsx scripts/chat-server.ts stop",
    "server:restart": "tsx scripts/chat-server.ts restart",
    "server:logs": "tsx scripts/chat-server.ts logs",
    "server:open": "tsx scripts/chat-server.ts open",
    "release": "tsx scripts/release.ts"
  },
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
